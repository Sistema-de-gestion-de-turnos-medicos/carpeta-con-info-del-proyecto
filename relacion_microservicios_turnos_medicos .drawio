          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- NOTA: nombre Feign inconsistente -->
        <mxCell id="nota_inconsistencia" value="Nota: el FeignClient se declara como &quot;ms-usuarios&quot; (con s) en ms-auth y ms-pacientes,&#10;pero el microservicio real registrado en Eureka es &quot;ms-usuario&quot; (sin s)." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="600" height="30" as="geometry" />
        </mxCell>

      </root>
