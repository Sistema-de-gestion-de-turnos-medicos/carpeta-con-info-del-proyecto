        <!-- FLECHAS: ms-disponibilidad -> ms-medicos -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;" edge="1" parent="1" source="ms_disp" target="ms_medicos">
