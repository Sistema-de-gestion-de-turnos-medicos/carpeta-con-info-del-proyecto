        <!-- FLECHAS: ms-notificaciones -> ms-pacientes, ms-medicos, ms-turno -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;" edge="1" parent="1" source="ms_notif" target="ms_pacientes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;" edge="1" parent="1" source="ms_notif" target="ms_medicos">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>
