        </mxCell>
        <mxCell id="reg2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#6c8ebf;startArrow=none;" edge="1" parent="1" source="ms_historial" target="ms_eureka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="reg3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#6c8ebf;startArrow=none;" edge="1" parent="1" source="ms_notif" target="ms_eureka">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="625" y="60"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="reg_label" value="Todos los microservicios se registran en ms-eureka" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6c8ebf;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="700" y="140" width="280" height="20" as="geometry" />
        </mxCell>

        <!-- FLECHAS: ms-pago -> ms-pacientes, ms-turno -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;" edge="1" parent="1" source="ms_pago" target="ms_pacientes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;" edge="1" parent="1" source="ms_pago" target="ms_turno">
          <mxGeometry relative="1" as="geometry" />
