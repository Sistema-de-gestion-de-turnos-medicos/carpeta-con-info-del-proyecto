        <mxCell id="nota_sinruta" value="Estos 5 microservicios solo son accesibles directamente por su puerto&#10;(ej. localhost:8086, 8089...), no a través del Gateway en localhost:8090." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
