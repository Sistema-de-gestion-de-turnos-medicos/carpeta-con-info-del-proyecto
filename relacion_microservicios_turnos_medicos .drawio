        <!-- FLECHAS DE REGISTRO EN EUREKA (todos los microservicios se registran) -->
        <mxCell id="reg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;strokeColor=#6c8ebf;startArrow=none;" edge="1" parent="1" source="ms_pago" target="ms_eureka">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="115" y="60"/></Array>
