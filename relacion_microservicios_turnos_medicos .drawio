        <!-- FLECHAS: ms-turno -> ms-medicos -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;startArrow=none;" edge="1" parent="1" source="ms_turno" target="ms_medicos">
          <mxGeometry relative="1" as="geometry" />
