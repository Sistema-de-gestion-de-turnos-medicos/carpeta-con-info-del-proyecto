        <!-- API GATEWAY (infraestructura, debajo de eureka) -->
        <mxCell id="ms_gateway" value="ms-gateway&#10;(API Gateway - 8090)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="160" width="220" height="50" as="geometry" />
